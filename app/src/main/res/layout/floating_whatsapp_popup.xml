<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/floating_popup_bg"
    android:padding="16dp"
    android:elevation="8dp">

    <!-- Service ID + Return Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvServiceId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Servicio #0000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />

        <TextView
            android:id="@+id/tvDistancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFC107"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvReturnIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textSize="24sp"
            android:visibility="gone"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Valor a cobrar -->
    <TextView
        android:id="@+id/tvValor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:visibility="gone"
        android:layout_marginBottom="4dp" />

    <!-- Ciudad -->
    <TextView
        android:id="@+id/tvCiudad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:drawablePadding="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Origen -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Origen:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="2dp" />

    <!-- Nombre de ubicación guardada -->
    <TextView
        android:id="@+id/tvLocationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFC107"
        android:visibility="gone"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvOrigen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="6dp" />

    <!-- Destino -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏁 Destino:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvDestino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="6dp" />

    <!-- Medio de pago + valor formateado (amarillo) -->
    <TextView
        android:id="@+id/tvMedioPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFC107"
        android:visibility="gone"
        android:layout_marginBottom="4dp" />

    <!-- Requisitos (highlighted yellow when return icon conditions met) -->
    <TextView
        android:id="@+id/tvRequisitosLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Requisitos:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvRequisitos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✅ Aceptar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnRoute"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🗺️ Ruta"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✖ Cerrar"
            android:textSize="14sp"
            android:backgroundTint="#666666"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
